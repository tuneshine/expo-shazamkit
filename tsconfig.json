// This file is deliberately left without expo-module-scripts' generated-file marker.
// `expo-module configure` greps each file for that marker and rsyncs its own template
// over any file carrying it, which would drop the rootDir below and break the build
// under TypeScript 6. Do not reintroduce the marker, even inside a comment.
{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src"
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*", "**/__rsc_tests__/*"]
}
