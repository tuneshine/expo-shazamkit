// Intentionally not marked "@generated by expo-module-scripts": that marker makes
// `expo-module configure` overwrite this file from its template on every `prepare`,
// which drops the rootDir below and breaks the build under TypeScript 6.
{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src"
  },
  "include": ["./src"],
  "exclude": ["**/__mocks__/*", "**/__tests__/*", "**/__rsc_tests__/*"]
}
